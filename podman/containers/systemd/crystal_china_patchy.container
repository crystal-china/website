[Unit]
Description=Crystal China Patchy

[Container]
Image=localhost/patchy:latest
Pod=crystal_china.pod
Pull=never

WorkingDir=/app
LogDriver=journald
Volume=%h/apps/patchy/config:/app/config:ro
Volume=%h/apps/patchy/data:/app/data:rw
Volume=%h/apps/patchy/locales:/app/locales:ro

# Kemal 接收上传文件时使用的临时目录。
Tmpfs=/tmp:rw,mode=1777

[Service]
Restart=on-failure
RestartSec=5

