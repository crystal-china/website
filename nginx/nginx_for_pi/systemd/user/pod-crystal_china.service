[Unit]
Description=Podman pod (existing): crystal_china
# 这两行可选：如果你依赖网络再放开
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes

# 只启动/停止“已存在”的 pod（不创建、不替换）
ExecStart=/usr/bin/podman pod start crystal_china
ExecStop=/usr/bin/podman pod stop -t 10 crystal_china

# 可选：避免 systemd 用户实例默认 NOFILE 太小
LimitNOFILE=1048576

[Install]
WantedBy=default.target
