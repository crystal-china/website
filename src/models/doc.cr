class Doc < BaseModel
  struct VoteCounts
    include JSON::Serializable

    property 👍 : Int32 = 0
    property 👎 : Int32 = 0
    property ❤️ : Int32 = 0
  end

  table do
    column path_index : String
    column view_count : Int32, autogenerated: true
    column content_digest : String?
    column content_updated_at : Time?

    has_one comment_thread : CommentThread?
    has_many comments : Comment, through: [:comment_thread, :comments]
    has_many votes : Vote

    column vote_counts : Doc::VoteCounts, serialize: true, autogenerated: true
  end
end
