class Space < BaseModel
  DEFAULT_ID            = 1_i64
  DEFAULT_CONTACT_EMAIL = "admin@crystal-china.org"
  SOURCE_URL_EXAMPLE    = "https://github.com/crystal-china/website"

  enum SmtpTlsMode
    Starttls = 1
  end

  struct FooterLink
    include JSON::Serializable

    getter title : String
    getter url : String
    getter icon : String

    def initialize(@title : String = "", @url : String = "", @icon : String = "")
    end
  end

  table do
    has_many topics : Topic, base_query_class: TopicQuery

    column name : String
    column slug : String
    column topics_count : Int32, autogenerated: true
    column logo_url : String?
    column contact_email : String?
    column source_url : String?
    # NULL 使用默认链接，空数组隐藏全部链接；数组顺序就是展示顺序。
    column footer_links : Array(Space::FooterLink)?, serialize: true
    column smtp_host : String?
    column smtp_port : Int32?
    column smtp_tls_mode : Space::SmtpTlsMode = :starttls
    column smtp_username : String?
    column encrypted_smtp_password : String?
    column email_from : String?
  end
end
