class Space < BaseModel
  DEFAULT_ID            = 1_i64
  DEFAULT_LOGO_PATH     = "svgs/crystal-china.svg"
  DEFAULT_CONTACT_EMAIL = "admin@crystal-china.org"
  DEFAULT_SOURCE_URL    = "https://github.com/crystal-china/website"

  enum SmtpTlsMode
    Starttls = 1
  end

  struct FooterLink
    include JSON::Serializable

    getter title : String
    getter url : String
    getter icon : String

    def initialize(@title : String = "", @url : String = "", @icon : String = "")
    end
  end

  DEFAULT_FOOTER_LINKS = [
    FooterLink.new(
      title: "GitHub",
      url: "https://github.com/crystal-china",
      icon: "svgs/github-icon.svg"
    ),
    FooterLink.new(
      title: "X",
      url: "https://x.com/crystalchinaorg",
      icon: "svgs/x-icon.svg"
    ),
    FooterLink.new(
      title: "Crystal",
      url: "https://crystal-lang.org/",
      icon: "svgs/crystal-lang-icon.svg"
    ),
  ]

  table do
    has_many topics : Topic, base_query_class: TopicQuery

    column name : String
    column slug : String
    column topics_count : Int32, autogenerated: true
    # 默认数据为 NULL 时，表单字段会显示默认值，用户可以更改并保存。
    # 但如果用户手动清空表单内容并保存，会保存为空字符串，对应隐藏对应入口；
    column logo_url : String?, allow_blank: true
    column contact_email : String?, allow_blank: true
    column source_url : String?, allow_blank: true
    # NULL 使用默认链接，空数组隐藏全部链接；数组顺序就是展示顺序。
    column footer_links : Array(Space::FooterLink)?, serialize: true
    column smtp_host : String?
    column smtp_port : Int32?
    column smtp_tls_mode : Space::SmtpTlsMode = :starttls
    column smtp_username : String?
    column encrypted_smtp_password : String?
    column email_from : String?
  end

  # 将本站资源路径解析为当前构建的图片地址；外部图片 URL 原样使用。
  def self.image_url(path_or_url : String) : String
    if (path = Lucky::AssetHelpers::ASSET_MANIFEST[path_or_url]?)
      Lucky::Server.settings.asset_host + path
    else
      path_or_url
    end
  end
end
